# Required in production
APP_ENV=production
SITE_URL=https://your-domain.com
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Owner/admin bootstrap (use a unique password of at least 12 characters)
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=AURELIS Owner

# Optional email notifications through Resend
RESEND_API_KEY=
RESEND_FROM=AURELIS <enquiries@yourdomain.com>
OWNER_NOTIFICATION_EMAIL=you@yourdomain.com
